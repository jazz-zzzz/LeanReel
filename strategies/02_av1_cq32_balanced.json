{
  "name": "AV1 NVENC CQ32 均衡快速",
  "description": "RTX 40 系及以上首选。AV1 硬件编码，速度快，适合批量压缩 SDR H.264；CQ32 是均衡档，兼顾体积和画质。",
  "is_preset": true,
  "video": {
    "encoder": "av1_nvenc",
    "crf": 0,
    "preset": "",
    "pix_fmt": "yuv420p10le",
    "gpu": true,
    "nv_preset": "p5",
    "rc": "vbr",
    "cq": 32
  },
  "hdr": {"mode": "preserve_hdr10", "dv_handling": "reinject_rpu"},
  "audio": {"mode": "keep_original", "remove_commentary": false},
  "subtitle": {"mode": "keep_all"},
  "filters": {"skip_x265": true, "min_size_gb": null, "only_remux": false},
  "estimated_savings": "45-65%",
  "quality_impact": "均衡压缩；默认仍跳过 HEVC/HDR/DV 片源"
}
